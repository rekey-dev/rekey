# Rekey production environment for `docker-compose.prod.yml` — set these in
# Dokploy → your Compose service → Environment (or in a `.env` next to the
# compose file). DO NOT commit real values; this file is the template.
#
# Generate each secret with the command in its comment, then paste the value.

# --- Hostnames (REQUIRED — `docker compose` refuses to run without them) ---
#
# Your domains, not ours. These drive the Traefik routers AND the origins the
# API hands out: API_HOST is what Rekey registers with Stripe/PayPal as the
# destination for YOUR payment webhooks, so a wrong value sends your payment
# notifications to somebody else's server. Point A records at this host before
# deploying — Let's Encrypt needs them resolvable.
API_HOST=api.example.com
PANEL_HOST=panel.example.com
# Only needed if you keep the `portal` service. See the note on it in
# docker-compose.prod.yml if you don't.
PORTAL_HOST=portal.example.com

# --- Secrets (REQUIRED) ---

# Postgres password for the bundled db (any strong URL-safe random string —
# a value containing @ : / or # breaks DATABASE_URL).
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Redis password. Same URL-safety rule as above.
#   openssl rand -hex 24
REDIS_PASSWORD=

# JWT signing secret — min 32 chars.
#   openssl rand -hex 32
JWT_SECRET=

# Token-at-rest encryption key — exactly 64 hex chars. Encrypts billing/OAuth
# credentials in the DB. CHANGING IT LATER makes existing ciphertext
# unreadable — set once, keep safe.
#   openssl rand -hex 32
ENCRYPTION_KEY=

# Super-admin key. Used three ways:
#   1. /api/v1/admin/* — Bearer token for tenant/app bootstrap CLI work.
#   2. /api/v1/admin/metrics/* — read-only dashboard endpoints.
#   openssl rand -hex 32
SUPER_ADMIN_KEY=

# --- Optional (every one of these defaults to today's behaviour) ---
#
# Everything below is already named in the compose file's `environment:` block,
# so setting it here is enough. The full list of what the API reads lives in
# apps/api/src/config/env.ts — that file is the authority, and this one is a
# hand-maintained subset of it. Nothing checks that the two agree, so if you add
# a variable there, add it here and to the compose `environment:` block as well:
# those blocks are allowlists, and an unlisted variable is silently not passed.

# Who may create an OPERATOR account: open (default) | invite | closed.
# `invite` requires a single-use key minted at POST /api/v1/admin/operator-invites;
# `closed` disables new-operator registration entirely. Existing operators sign
# in regardless. A private deployment almost certainly wants one of these two.
# OPERATOR_SIGNUP_MODE=invite

# Whether a signed-in operator may create ADDITIONAL workspaces themselves:
# open (default) | disabled. Pairs with the line below — a per-workspace ceiling
# is worth nothing if any operator, including one merely invited into a team,
# can mint a fresh workspace with a fresh ceiling. Gates creation only;
# switching, listing and renaming keep working.
# WORKSPACE_CREATION=disabled

# Starting ceilings for every workspace this deployment creates — JSON matching
# TenantLimitsSchema. Leave empty and new workspaces are UNLIMITED, which is
# what they are today: `Tenant.limits` is otherwise only ever written after the
# fact by the super-admin endpoint. A malformed value fails the boot on purpose,
# rather than leaving you believing new workspaces are capped when they are not.
# DEFAULT_TENANT_LIMITS={"maxProductionApps":1}

# Network gate on /api/v1/admin/* — comma-separated IPs and/or CIDRs, checked
# BEFORE the key comparison. Unset means no network restriction.
# ADMIN_IP_ALLOWLIST=203.0.113.4,198.51.100.0/24

# Behind a reverse proxy (Traefik, Cloudflare): a hop count or an IP/CIDR
# allowlist. Unset means X-Forwarded-For is NOT trusted, so rate limits and
# account lockout key on the proxy's IP instead of the real client. Behind one
# Traefik, `1` is right.
# TRUSTED_PROXIES=1

# Session cookies get their `Secure` flag from the request: the web apps read
# X-Forwarded-Proto (falling back to Host) and mark cookies Secure for anything
# that is not plain HTTP on loopback. Behind Traefik this is already right and
# you should leave it unset. Set it to `false` ONLY if you front the stack with
# something serving plain HTTP that sets no forwarded proto — that ships session
# cookies in the clear, which is why it has to be said out loud.
# REKEY_COOKIE_SECURE=false

# RFC 7591 dynamic client registration on the operator MCP authorization
# server: `open` (default) or `disabled`. Open is how Claude Desktop / Claude
# Code / Cursor connect by discovery. Registration hands out no data and no
# token — an operator still approves at the panel — but it DOES allowlist a
# redirect_uri of the registrant's choosing, and /oauth/authorize refuses any
# redirect_uri its client didn't register. That allowlist entry is the missing
# ingredient in a consent-phishing link, so close this once your clients are
# connected.
# OPERATOR_MCP_DYNAMIC_REGISTRATION=disabled

# Default transactional email via Resend. Unset = Rekey sends no mail and
# returns raw tokens to the API caller instead. The from-address must be on a
# domain YOU have verified in Resend.
# RESEND_DEFAULT_API_KEY=
# RESEND_DEFAULT_FROM=support@example.com
# RESEND_DEFAULT_FROM_NAME=Example

# Operator panel passkeys (WebAuthn). `RP_ID` is the panel hostname — no
# scheme, no port. Unset means operator passkey endpoints refuse with
# WEBAUTHN_NOT_CONFIGURED rather than binding credentials to a guessable id.
# PANEL_WEBAUTHN_RP_ID=panel.example.com
# PANEL_WEBAUTHN_RP_ORIGINS=https://panel.example.com
# PANEL_WEBAUTHN_RP_NAME=Example

# Operator social login for the PANEL (not end-users — those are configured
# per Application). A provider activates only when BOTH values are set.
# PANEL_OAUTH_GOOGLE_CLIENT_ID=
# PANEL_OAUTH_GOOGLE_CLIENT_SECRET=
# PANEL_OAUTH_GITHUB_CLIENT_ID=
# PANEL_OAUTH_GITHUB_CLIENT_SECRET=

# Your own GA4 property for the operator panel. Baked into the client bundle at
# build time, so changing it needs a rebuild. Unset = no analytics.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
