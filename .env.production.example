# ReliPay production environment — set these in Dokploy → your Compose
# service → Environment. DO NOT commit real values; this file is the template.
#
# Generate each secret with the command in its comment, then paste the value.

# Postgres password for the bundled db (any strong random string).
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# JWT signing secret — min 32 chars.
#   openssl rand -hex 32
JWT_SECRET=

# Session secret — exactly 64 hex chars.
#   openssl rand -hex 32
SESSION_SECRET=

# Token-at-rest encryption key — exactly 64 hex chars. Encrypts billing/OAuth
# credentials in the DB. CHANGING IT LATER makes existing ciphertext
# unreadable — set once, keep safe.
#   openssl rand -hex 32
ENCRYPTION_KEY=

# Super-admin key. Used three ways:
#   1. /api/v1/admin/* — Bearer token for tenant/app bootstrap CLI work.
#   2. /api/v1/admin/metrics/* — read-only dashboard endpoints.
#   3. admin.relipay.dev — the operator pastes this on the login form, and
#      the admin container compares it against this env value via
#      timingSafeEqual. Cookie carries an opaque session id, NOT the key.
#   openssl rand -hex 32
SUPER_ADMIN_KEY=

# Default transactional email via Resend. Sender (support@relipay.dev) +
# from-name are set in docker-compose.prod.yml; only the key is a secret.
RESEND_DEFAULT_API_KEY=

# Discord webhook for the marketing site's contact + beta-access forms.
# Server-side only — the marketing API routes POST submissions here; it is
# NEVER exposed to the browser. Create at: Discord → Server Settings →
# Integrations → Webhooks.
DISCORD_WEBHOOK_URL=

# Note: API_URL, PUBLIC_WEBHOOK_BASE_URL, CORS_ALLOWED_ORIGINS, RELIPAY_URL,
# PANEL_URL, RESEND_DEFAULT_FROM/_NAME and the domains are already set in
# docker-compose.prod.yml.
