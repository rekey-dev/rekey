# Operator panel (panel.rekey.dev). Copy to .env.local.

# Base URL of the Rekey API. Server-side fetches (audit-log / end-user
# exports, billing) read this. Required.
REKEY_URL=http://localhost:3030

# Same API base, but exposed to the browser — used to render copy-paste API /
# MCP endpoint snippets on the app pages. REQUIRED — there is no fallback; the
# Rekey-owned default was removed, and unset renders a visible
# `<set NEXT_PUBLIC_API_URL>` sentinel rather than a plausible-looking wrong URL.
NEXT_PUBLIC_API_URL=http://localhost:3030

# Public origin of THIS panel — used to build team accept-invite links.
# Defaults to http://localhost:3031.
PANEL_URL=http://localhost:3031

# Reverse proxies in front of THIS panel, as a hop count. Decides which client
# IP the panel forwards to the API (which rate-limits sign-in and refresh on
# it). 0 (default): reached directly, any client-sent X-Forwarded-For is
# discarded and the socket address is used. 1: one proxy (Traefik). Never set
# it higher than the real count; that lets a client pick its own IP.
# PANEL_TRUSTED_PROXIES=0

# Required with PANEL_TRUSTED_PROXIES >= 1. The proxy must send it as the
# X-Rekey-Proxy-Secret request header; X-Forwarded-For is believed only on
# requests that carry it. Generate with: openssl rand -hex 32
# PANEL_PROXY_SECRET=

# Optional. When set, every server-side call to the API carries it as the
# X-Rekey-Caller-Secret header, plus the visitor's address as X-Rekey-Client-Ip
# when the panel validated one, so the API can believe it whatever network path
# the call took. Must equal the API's
# INTERNAL_CALLER_SECRET. Server-only: never prefix it NEXT_PUBLIC_.
# INTERNAL_CALLER_SECRET=

# Public URL of the hosted customer portal, shown on each app's Portal page.
# No default — the portal.rekey.dev fallback was removed. Unset simply hides it.
# NEXT_PUBLIC_PORTAL_URL=http://localhost:3050

# (optional) GA4 measurement id. Public by nature. No default — unset means the
# panel loads no analytics at all.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
