# Hosted customer portal V2 (portal.rekey.dev). Copy to .env.local.
#
# This portal serves the end-users of ANY opted-in Application, resolved by the
# <slug> in the URL (portal.rekey.dev/<slug>). It holds NO per-app secret key —
# it identifies each app by its PUBLIC config and authorizes users with their
# own token. See docs/portal.md.

# Base URL of the Rekey API (server-side fetches + the publishable-key client
# both hit this). Required.
REKEY_URL=http://localhost:3030

# Public URL of THIS portal — used to build checkout success/cancel return URLs.
# Defaults to http://localhost:3050.
PORTAL_BASE_URL=http://localhost:3050

# Optional. How many proxies you run in front of the portal (Traefik alone = 1).
# The portal then forwards the visitor's address on its API calls, so the API's
# per-IP limits count each visitor rather than the portal. Believed only on
# requests that carry PORTAL_PROXY_SECRET. Unset forwards nothing.
# PORTAL_TRUSTED_PROXY_HOPS=1

# Required with the above: your proxy sends it as X-Rekey-Proxy-Secret on every
# request. Generate: openssl rand -hex 32
# PORTAL_PROXY_SECRET=

# Needed when the portal calls the API's public origin rather than a private
# address: sent as X-Rekey-Caller-Secret, and must equal the API's value.
# INTERNAL_CALLER_SECRET=
