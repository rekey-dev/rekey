# Hosted customer portal V2 (portal.relipay.dev). Copy to .env.local.
#
# This portal serves the end-users of ANY opted-in Application, resolved by the
# <slug> in the URL (portal.relipay.dev/<slug>). It holds NO per-app secret key —
# it identifies each app by its PUBLIC config and authorizes users with their
# own token. See docs/portal.md.

# Base URL of the ReliPay API (server-side fetches + the publishable-key client
# both hit this). Required.
RELIPAY_URL=http://localhost:3030

# Public URL of THIS portal — used to build checkout success/cancel return URLs.
# Defaults to http://localhost:3050.
PORTAL_BASE_URL=http://localhost:3050
