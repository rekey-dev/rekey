# Read-only super-admin dashboard (admin.relipay.dev). Copy to .env.local.

# Base URL of the ReliPay API the dashboard reads metrics from.
RELIPAY_URL=http://localhost:3030

# Super-admin key — pasted on the login form and compared (timingSafeEqual)
# against this value; also sent as the Bearer token to /api/v1/admin/metrics/*.
# MUST match the API's SUPER_ADMIN_KEY. Generate with: openssl rand -hex 32
SUPER_ADMIN_KEY=
