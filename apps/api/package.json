{
  "name": "@relipay/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"(eslint not yet wired)\"",
    "test": "vitest run",
    "openapi:dump": "tsx scripts/dump-openapi.mts openapi.json",
    "db:generate": "prisma generate --schema ../../prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema ../../prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema ../../prisma/schema.prisma",
    "db:studio": "prisma studio --schema ../../prisma/schema.prisma"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/formbody": "^8.0.2",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.2.0",
    "@fastify/sensible": "^6.0.1",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.0",
    "@paypal/paypal-server-sdk": "^2.3.0",
    "@prisma/client": "6.10.1",
    "@relipay/shared-types": "workspace:*",
    "@simplewebauthn/server": "^13.3.0",
    "@t3-oss/env-core": "^0.11.1",
    "argon2": "^0.41.1",
    "fastify": "^5.1.0",
    "fastify-raw-body": "^5.0.0",
    "ioredis": "^5.11.0",
    "ip-address": "^10.2.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.16",
    "otpauth": "^9.3.4",
    "pino": "^9.5.0",
    "razorpay": "^2.9.6",
    "resend": "^6.12.3",
    "stripe": "^17.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^6.4.17",
    "prisma": "6.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
