{
  "name": "@rekey.dev/mcp",
  "version": "2.0.0-rc.9",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "description": "Model Context Protocol server for Rekey \u2014 lets Claude Desktop / Cursor / Claude Code introspect a deployment.",
  "type": "module",
  "bin": {
    "rekey-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "AGENTS.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"(eslint not yet wired)\"",
    "test": "tsc -p tsconfig.json && vitest run"
  },
  "keywords": [
    "rekey",
    "mcp",
    "model-context-protocol",
    "ai"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
