{
  "name": "@rekey.dev/nextjs",
  "version": "2.2.0-rc.2",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "description": "Rekey helpers for Next.js \u2014 middleware, server-side auth(), cookie session.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "import": "./dist/middleware.js",
      "default": "./dist/middleware.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./cookies": {
      "types": "./dist/cookies.d.ts",
      "import": "./dist/cookies.js",
      "default": "./dist/cookies.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js",
      "default": "./dist/errors.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "AGENTS.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "tsc -p tsconfig.test.json && vitest run",
    "lint:fix": "eslint . --fix --fix-type problem,suggestion,layout"
  },
  "keywords": [
    "next.js",
    "auth",
    "middleware",
    "rekey"
  ],
  "peerDependencies": {
    "next": "^14.0.0 || ^15.0.0 || ^16.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@rekey.dev/node": "workspace:^",
    "@rekey.dev/react": "workspace:^",
    "@rekey.dev/shared-types": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "next": "^15.5.18",
    "react": "^19.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
