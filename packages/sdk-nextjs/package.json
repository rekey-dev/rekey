{
  "name": "@relipay/nextjs",
  "version": "1.1.1",
  "license": "MIT",
  "description": "ReliPay helpers for Next.js — middleware, server-side auth(), cookie session.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "import": "./dist/middleware.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "files": [
    "dist",
    "AGENTS.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"(eslint not yet wired)\"",
    "test": "echo \"(nextjs SDK tests deferred to panel/demo e2e)\""
  },
  "keywords": [
    "next.js",
    "auth",
    "middleware",
    "relipay"
  ],
  "peerDependencies": {
    "next": "^14.0.0 || ^15.0.0 || ^16.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@relipay/node": "workspace:*",
    "@relipay/react": "workspace:*",
    "@relipay/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "next": "^15.5.18",
    "react": "^19.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
