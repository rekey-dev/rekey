{
  "name": "@rekey.dev/cli",
  "version": "2.0.0-rc.7",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "description": "Rekey command-line interface \u2014 designed for both human developers and AI agents.",
  "type": "module",
  "bin": {
    "rekey": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "AGENTS.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"(eslint not yet wired)\"",
    "test": "tsc -p tsconfig.json && vitest run"
  },
  "keywords": [
    "rekey",
    "cli",
    "auth",
    "billing"
  ],
  "dependencies": {
    "@rekey.dev/node": "workspace:^",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
