{
  "name": "@rekey.dev/node",
  "version": "2.0.0-rc.1",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "description": "Rekey server SDK for Node — auth + billing for your application.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "AGENTS.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"(eslint not yet wired)\"",
    "test": "vitest run"
  },
  "keywords": [
    "auth",
    "billing",
    "stripe",
    "paypal",
    "clerk-alternative",
    "self-hosted",
    "saas",
    "subscription"
  ],
  "dependencies": {
    "@rekey.dev/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
