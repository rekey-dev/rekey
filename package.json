{
  "name": "rekey",
  "version": "0.0.0",
  "private": true,
  "description": "Auth + Billing + Admin-as-a-Service for multiple applications",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm db:generate && turbo run build",
    "dev": "pnpm db:generate && dotenv -- turbo run dev",
    "lint": "eslint .",
    "typecheck": "pnpm db:generate && turbo run typecheck",
    "test": "pnpm db:generate && turbo run test",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:studio": "prisma studio --schema prisma/schema.prisma",
    "lint:fix": "eslint . --fix --fix-type problem,suggestion,layout",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.3",
    "@prisma/client": "6.10.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5",
    "globals": "^17.11.0",
    "lint-staged": "^17.4.1",
    "playwright": "^1.60.0",
    "prisma": "6.10.1",
    "simple-git-hooks": "^2.14.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8"
  },
  "pnpm": {
    "overrides": {
      "fast-uri@<3.1.8": "^3.1.8",
      "postcss@>=8.0.0 <8.5.10": ">=8.5.10",
      "hono@<4.13.11": "^4.13.11",
      "ip-address@<10.7.4": "^10.7.4",
      "brace-expansion@>=5.0.0 <5.0.12": "^5.0.12",
      "qs@<6.16.0": "^6.16.0",
      "sharp@<0.35.5": "^0.35.5",
      "form-data@>=4.0.0 <4.0.6": "^4.0.6",
      "axios@<1.20.0": "^1.20.0",
      "follow-redirects@<1.16.1": "^1.16.1",
      "nanoid@>=3.0.0 <3.3.18": "^3.3.18",
      "nanoid@>=5.0.0 <5.1.16": "^5.1.16",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "devalue@<5.9.3": "^5.9.3",
      "source-map-js@<1.2.2": "^1.2.2",
      "svgo@>=4.0.0 <4.1.0": "^4.1.0",
      "smol-toml@<1.9.0": "^1.9.0"
    }
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,js,jsx}": [
      "eslint --fix --fix-type problem,suggestion,layout --max-warnings=0"
    ]
  }
}
