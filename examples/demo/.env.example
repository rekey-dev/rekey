# Copy to .env.local (gitignored) and fill in. NEVER commit RELIPAY_SECRET.

# Base URL of the ReliPay API this demo talks to.
RELIPAY_URL=http://localhost:3030

# Application SECRET key (rp_live_… / rp_test_…). Server-only — the @relipay/node
# client reads it. Create an Application in the panel, copy its secret key here.
RELIPAY_SECRET=

# (optional) Public origin of THIS demo app — used to build billing checkout
# return URLs. Defaults to http://localhost:3032.
# PUBLIC_DEMO_URL=http://localhost:3032
