# Single-app self-host portal (v1). Copy to .env.local. See docs/portal.md.
# Serves the end-users of exactly ONE Application, authenticating to the API
# with that Application's server-side secret key.

# Base URL of the ReliPay API. Required.
RELIPAY_URL=http://localhost:3030

# Application SECRET key (rp_live_… / rp_test_…). Server-only — NEVER ship to
# the browser. RELIPAY_SECRET is accepted as a fallback spelling.
RELIPAY_SECRET_KEY=

# Public URL of THIS portal — checkout success/cancel return links.
# Defaults to http://localhost:3050.
PORTAL_BASE_URL=http://localhost:3050

# (optional) Display name in the header; falls back to the Application's name.
# PORTAL_APP_NAME=
