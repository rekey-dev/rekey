# ---------------------------------------------------------------------------
# ReliPay wiring for the Next.js SaaS boilerplate.
#
# Copy this file to `.env.local` (which is gitignored) and fill in the values.
# NEVER commit `.env.local` — RELIPAY_SECRET is a live secret key.
# ---------------------------------------------------------------------------

# Base URL of the ReliPay API you're talking to.
RELIPAY_URL=https://api.relipay.dev

# Application SECRET key (rp_live_… / rp_test_…). Server-only — the
# @relipay/nextjs/server helpers read this. NEVER ship to the browser.
RELIPAY_SECRET=rp_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Application PUBLIC key (rp_pub_…). Safe to expose to the browser; the
# @relipay/react provider uses it. For the deployed "qr" app this is:
#   rp_pub_qr_eI0RXUQCHUVU8gnw
NEXT_PUBLIC_RELIPAY_PUBLIC_KEY=rp_pub_qr_eI0RXUQCHUVU8gnw

# (optional) Application slug, used to render the MCP "Connect to Claude"
# helper on the account page. The deployed demo app's slug is "qr".
NEXT_PUBLIC_RELIPAY_APP_SLUG=qr
