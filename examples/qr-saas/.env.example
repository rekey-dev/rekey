# Metered QR-code SaaS example. Copy to .env (gitignored).
#
# Two flows use this file:
#   1. The running server (server.ts) — needs RELIPAY_URL + the QR_* knobs.
#   2. The one-shot setup script (setup-deployed.ts) — provisions plans/coupons
#      on a deployed ReliPay using operator credentials below.

# ── Runtime server ─────────────────────────────────────────────────────────
# Base URL of the ReliPay API. Defaults to http://localhost:3030.
RELIPAY_URL=http://localhost:3030

# Port this app listens on (default 3000) and its public origin (default
# http://localhost:<PORT>) used for billing checkout return URLs.
# PORT=3000
# PUBLIC_BASE=http://localhost:3000

# Free scans before metering kicks in (default 8), and demo pacing (default 700).
# QR_FREE_SCANS=8
# QR_PACE_MS=700

# On-disk paths for the local store + cached bootstrap config.
# QR_DATA_PATH=.data/qr-store.json
# QR_CONFIG_PATH=.data/relipay-config.json
# Set to 1 to reuse a previously bootstrapped config instead of re-provisioning.
# QR_REUSE_CONFIG=

# ── setup-deployed.ts (provisioning script only) ─────────────────────────────
# The Application id to configure.
RELIPAY_APP_ID=

# Operator auth: EITHER paste a short-lived operator token…
# RELIPAY_OPERATOR_TOKEN=
# …OR provide email + password (preferred — the password never leaves your
# machine; refuses MFA-gated operators).
# RELIPAY_OPERATOR_EMAIL=
# RELIPAY_OPERATOR_PASSWORD=
